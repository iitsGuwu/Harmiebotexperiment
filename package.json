{
  "name": "harmie-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Discord bot mirroring harmie.xyz — pageant voting, gallery, leaderboard, and Harmony community stats via linked Solana wallets.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:verify": "esbuild src/verify-client.js --bundle --format=esm --platform=browser --target=es2020 --outfile=public/verify.js",
    "start": "node src/index.js",
    "start:all": "sh scripts/start-all.sh",
    "register": "node src/register.js",
    "dev": "node --watch src/index.js",
    "sync:meme-assets": "node scripts/sync-harmie-meme-assets.js",
    "sync:harmies-assets": "node scripts/sync-harmies-assets.js",
    "scrape:harmies:opensea": "node scripts/scrape-harmies-opensea.mjs"
  },
  "dependencies": {
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-phantom": "^0.9.29",
    "@solana/wallet-adapter-solflare": "^0.6.33",
    "@solana/wallet-standard-features": "^1.3.0",
    "@solana/wallet-standard-util": "^1.1.2",
    "@solana/web3.js": "^1.98.4",
    "@solflare-wallet/sdk": "^1.4.2",
    "@wallet-standard/app": "^1.1.0",
    "axios": "^1.15.2",
    "better-sqlite3": "^11.5.0",
    "bs58": "^6.0.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jimp": "^1.6.1",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
